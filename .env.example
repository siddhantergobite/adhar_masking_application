# Local inference tuning. CPU is the default; compatible CUDA runtimes can accelerate both models.
AADHAAR_YOLO_DEVICE=cpu
AADHAAR_OCR_DEVICE=cpu
AADHAAR_OCR_MAX_LONG_EDGE=960
AADHAAR_OCR_AUDIT_MAX_LONG_EDGE=1200
AADHAAR_OCR_CPU_THREADS=4
AADHAAR_ORIENTATION_ATTEMPTS=4

# Local serial profile: run Uvicorn with --workers 1 to process one document at a time.
# Four OCR threads improve single-document latency on the tested 8-logical-CPU workstation.
AADHAAR_BATCH_POLL_SECONDS=0.25
AADHAAR_BATCH_LEASE_SECONDS=300

# Batch limits and retention.
AADHAAR_BATCH_MAX_FILES=30
AADHAAR_BATCH_MAX_PENDING_FILES=90
AADHAAR_BATCH_MAX_BYTES=786432000
AADHAAR_BATCH_RETENTION_HOURS=24
AADHAAR_BATCH_MAX_ATTEMPTS=3
# Defaults to a private local application-data folder. Optionally set these:
# AADHAAR_BATCH_INPUT_ROOT=C:\Users\admin\Documents\AadhaarInbox
# AADHAAR_BATCH_STORAGE_ROOT=C:\Users\admin\AppData\Local\AadhaarMaskingWorkbench\batches

# Optional multi-host mode. Install both backend/requirements-postgres.txt and
# backend/requirements-s3.txt. Use a managed PostgreSQL database and private
# S3/R2 buckets with three non-overlapping prefixes. Keep credentials in a
# secret manager or the ignored local .env file, never in source control.
# AADHAAR_DATABASE_URL=postgresql://user:password@db-host:5432/aadhaar_masking
# AADHAAR_DB_POOL_SIZE=4
# Use the S3/R2 bucket and input/output prefixes configured below. The
# temporary upload prefix must be separate from both; its default is shown.
# AADHAAR_S3_TEMP_PREFIX=aadhaar/queued-input

# For a trusted reverse proxy, require a secret API key for all /api routes.
# The proxy must inject X-API-Key; never put this value in frontend variables.
# AADHAAR_REQUIRE_API_KEY=true
# AADHAAR_API_KEY=replace-with-a-long-random-secret
# Optional separate batch key. A gateway sends this as X-Batch-API-Key.
# AADHAAR_BATCH_API_KEY=replace-with-a-long-random-secret

# Optional S3 source/destination. Install backend/requirements-s3.txt first.
# Keep the actual .env file out of Git and use narrowly scoped credentials.
# AADHAAR_S3_INPUT_BUCKET=your-private-bucket
# AADHAAR_S3_INPUT_PREFIX=aadhaar/inbox
# AADHAAR_S3_OUTPUT_BUCKET=your-private-bucket
# AADHAAR_S3_OUTPUT_PREFIX=aadhaar/masked
# AADHAAR_S3_REGION=ap-south-1
# AADHAAR_S3_ENDPOINT_URL=

# Cloudflare R2 (private bucket). Create an R2 API token limited to this bucket.
# The app uses the R2 S3-compatible API; it does not make the bucket public.
# Install backend/requirements-s3.txt before enabling the R2 buttons.
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_INPUT_PREFIX=aadhaar/inbox
# CLOUDFLARE_R2_UPLOAD_PREFIX=aadhaar/uploads
# CLOUDFLARE_R2_OUTPUT_PREFIX=aadhaar/masked

# Cloudflare Workers KV (Free-plan namespace; no R2 subscription required).
# Create a token with Workers KV Storage Edit, restricted to this account where possible.
# Keep the token in this backend-only .env file; never put it in frontend variables.
# CLOUDFLARE_KV_ACCOUNT_ID=
# CLOUDFLARE_KV_NAMESPACE_ID=
# CLOUDFLARE_KV_API_TOKEN=
# CLOUDFLARE_KV_INPUT_PREFIX=aadhaar/inbox
# CLOUDFLARE_KV_OUTPUT_PREFIX=aadhaar/masked
