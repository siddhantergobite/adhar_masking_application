# Azure OpenAI resource endpoint and key stay in your local, ignored .env file.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your-secret-key
# This must match the deployment name in your Azure resource.
AZURE_OPENAI_MODEL=gpt-5-nano

# Local CPU inference tuning. The final masked copy is still checked at 1200 px.
AADHAAR_OCR_MAX_LONG_EDGE=960
AADHAAR_OCR_AUDIT_MAX_LONG_EDGE=1200
AADHAAR_OCR_CPU_THREADS=4
